# =========================================================================
#  Front controller -- URL bersih (tanpa "index.php?module=...").
#  Semua request yang BUKAN file/folder nyata (assets, uploads) diarahkan
#  ke index.php. Router (core/Router.php) yang memecah path jadi
#  module / action / id.
#
#  Contoh:
#    /dashboard                 -> module=dashboard
#    /purchase_order            -> module=purchase_order&action=index
#    /purchase_order/create     -> module=purchase_order&action=create
#    /purchase_order/edit/5     -> module=purchase_order&action=edit&id=5
#    /settings?tab=bank         -> module=settings + ?tab=bank
#
#  URL lama (index.php?module=...&action=...) TETAP jalan (fallback).
#  Bekerja di sub-folder (localhost/stok-proyek/public/...) MAUPUN saat
#  DocumentRoot langsung ke folder public/ (mis. stok.hexamultienergi.com/...).
# =========================================================================

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Paksa HTTPS -- HANYA untuk domain publik ------------------------
    # Redirect 301 http->https, KECUALI untuk akses lokal / LAN yang memang
    # dipakai lewat http (localhost, IP privat 10/172.16-31/192.168, nama
    # host tanpa titik, dan domain internal .local/.lan/.internal/.home/.test).
    # Menghormati X-Forwarded-Proto/-Ssl dari proxy/CDN yang terminate SSL.
    # Kalau nanti mau paksa HTTPS di mana pun, hapus baris-baris pengecualian
    # HTTP_HOST di bawah.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteCond %{HTTP:X-Forwarded-Ssl} !=on [NC]
    RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^10\.\d+\.\d+\.\d+(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[01])\.\d+\.\d+(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^192\.168\.\d+\.\d+(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^[^.]+(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !\.(local|lan|internal|home|test)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Jangan rewrite file / folder yang memang ada (assets, uploads, dst).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Sisanya -> front controller. QSA supaya query string (?tab=, ?id=) ikut.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>
